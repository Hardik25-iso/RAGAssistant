# Local development settings. Copy to .env and fill in the keys.
# NEVER commit .env. In production these come from AWS SSM Parameter Store.

GROQ_API_KEY=
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Seeded on first start (admin accounts cannot self-register)
ADMIN_EMAIL=admin@studyrag.app
ADMIN_PASSWORD=ChangeMe123

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
EMBEDDINGS_PROVIDER=gemini
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set to false only for the "before" error-handling measurements
ENABLE_RESILIENCE=true
